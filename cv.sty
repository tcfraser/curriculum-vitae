\newcommand{\academicsection}[2]{\bfseries{#1}\normalfont{%
    \begin{changemargin}{0pt}{0pt}%
        #2
    \end{changemargin}%
}}

\newenvironment{academiclist}{%
    \renewcommand{\item}[3]{%
        {\sc ##1} & {##2}\\
                  & {##3}\medskip\\
    }%
    \tabularx{\linewidth}{rX}%
}%
{\endtabularx}%


\newenvironment{paperlist}{%
    \renewcommand{\item}[4]{%
        {##1} & {##3}\\
        & {##2}\ifstrempty{##4}{\medskip}{}\\
        \ifstrempty{##4}{}{& {##4} \medskip\\}
    }%
    \tabularx{\linewidth}{rX}%
}%
