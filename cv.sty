\def\changemargin#1#2{\list{}{\rightmargin#2\leftmargin#1}\item[]}
\let\endchangemargin=\endlist

% The name at the top of the CV
\newcommand{\cvname}[1]{\nameheader{#1}{Curriculum Vitae}}
\newcommand{\nameheader}[2]{
    {\Huge{\textbf{#1}}}\vspace{0.5em}\\
    {\Large{\textit{#2}}}\\
    \today
}
% Information underneath CV
\newcommand{\cvinfo}[1]{%
    \begin{center}%
        \normalfont{#1}%
        \vspace{-9pt}%
    \end{center}%
}

\setcounter{secnumdepth}{-1}
\makeatletter
\let\old@section\section
\renewcommand{\section}[2][]{%
    \vspace{-1em}
    \old@section[#1]{\normalfont{\textbf{\textsc{#2}}}}%
    \vspace{-15pt}%
    \rule{\linewidth}{0.5pt}%
    \vspace{5pt}%
}
\makeatother

\newenvironment{personallist}{%
    \renewcommand{\item}[2]{%
        {\sc ##1} & {##2} \\
    }%
    \tabularx{\linewidth}{rX}%
}%
{\endtabularx}%


\newenvironment{educationlist}{%
    \renewcommand{\item}[4]{%
        {\sc ##1} & { ##2} \\
        \ifstrempty{##3}{}{& { ##3} \\}
        & {##4} \medskip \\
    }%
    \tabularx{\linewidth}{rX}%
}%
{\endtabularx}%

\newenvironment{experiencelist}{%
    \renewcommand{\item}[4]{%
        {\sc ##1} & {##2} \\
        \ifstrempty{##3}{}{& { ##3} \\}
        & {##4} \medskip \\
    }%
    \tabularx{\linewidth}{rX}%
}%
{\endtabularx}%

\newenvironment{teachinglist}{%
    \renewcommand{\item}[4]{%
        {\sc ##1} & { ##2} & \\%{##4}\\
                  & { ##3} & \medskip\\
    }%
    \newcommand\subfield[1]{%
        & {[##1]} & \medskip\\
    }%
    \tabularx{\linewidth}{rXl}%
}%
{\endtabularx}%

\newenvironment{awardlist}{%
